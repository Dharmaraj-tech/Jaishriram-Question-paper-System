# Jaishriram College Questionpaper Management System Backend Configuration

# Server Port
PORT=5000

# Environment (development | production)
NODE_ENV=production

# Security / JWT Secret (Change this to a strong random secret key in production!)
JWT_SECRET=super-secret-jaishriram-jwt-key-change-this-in-production

# JWT Expiration
JWT_EXPIRES_IN=7d

# Admin Default Credentials (used on initial setup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@jaishriram.edu.in
ADMIN_PASSWORD=admin123

# CORS Origin Allowed (e.g. https://my-frontend-domain.com or * for all)
CORS_ORIGIN=*

# Max File Size Upload Limit in MB
MAX_FILE_SIZE_MB=25
